# ---------------------------------------------------------------------------
# Tung-Tung backend environment template
# Copy this file to `backend/.env` and replace the placeholder values:
#     cp backend/.env.example backend/.env
# Never commit a real `backend/.env`. Placeholders only in this template.
# Every variable below is actually read by the backend source (see notes).
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Read by: backend/src/config/db.ts
# Default when unset: mongodb://localhost:27017/tungtung
# The example below is the local development value (identical to the built-in default) and contains
# no credentials - replace it with your own connection string.
MONGODB_URI=mongodb://localhost:27017/tungtung

# Secret used to sign and verify JWT access tokens.
# Read by: backend/src/services/authService.ts
# REQUIRED - there is no default and no fallback. If it is missing or empty the API refuses to
# start (`requireJwtSecret()` in backend/src/server.ts) and every sign/verify call fails with a
# clear configuration error instead of silently using a hard-coded secret.
# EXAMPLE PLACEHOLDER ONLY - generate your own and keep it out of version control, e.g.
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# HTTP port for the Express API and the Socket.IO server (they share one HTTP server).
# Read by: backend/src/server.ts
# Default when unset: 5000
PORT=5000

# Runtime environment flag.
# Read by: backend/src/realtime/dailyEvent.ts
# Default when unset: development (Node.js default)
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API (CORS allowlist).
# Read by: backend/src/realtime/socketServer.ts (`allowedCorsOrigins()` /
#          `corsOriginPolicy()`), which is applied to BOTH the REST API
#          (backend/src/server.ts) and the Socket.IO server - one shared policy.
# Default when unset: http://localhost:5173,http://localhost:4173 (Vite dev server + Vite preview),
# which is what the local development setup needs.
# There is no wildcard: list every front-end origin explicitly, e.g.
#     CORS_ORIGIN=http://localhost:5173,https://your-frontend.example
CORS_ORIGIN=http://localhost:5173

# Rate limiting for the credential endpoints (POST /api/auth/login and POST /api/auth/register).
# Read by: backend/src/server.ts
# Default when unset: 50 requests per 15 minutes (AUTH_RATE_LIMIT_WINDOW_MS = 900000 ms) per IP.
# Exceeding the limit returns HTTP 429 with a JSON message. No other route is rate limited,
# so authenticated endpoints such as GET /api/auth/me are unaffected.
AUTH_RATE_LIMIT_MAX=50

# Sliding window for the limit above, in milliseconds (900000 = 15 minutes).
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# Frontend-only variable (NOT read by the backend) - it belongs in `frontend/.env`:
#     VITE_API_URL=http://localhost:5000
# Read by: frontend/src/lib/api.ts (REST base URL) and
#          frontend/src/hooks/useLive.ts (Socket.IO server URL).
# Default when unset: http://localhost:5000
# ---------------------------------------------------------------------------

# Note: the CORS allowlist above (`CORS_ORIGIN`) is the only place where allowed origins are
# configured - there is no separate REST/Socket.IO setting. Requests without an Origin header
# (curl, server-to-server calls, the test suite) are not browser cross-origin requests and are
# unaffected by the allowlist.
